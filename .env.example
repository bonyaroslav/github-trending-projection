# .env.example
# Copy this file to ".env" for local development and fill real values there.
# IMPORTANT:
# - Never commit ".env" (add it to .gitignore).
# - ".env.example" must contain ONLY placeholders / safe defaults.

# --- GitHub access ---
# Required for GitHub GraphQL API calls.
GITHUB_TOKEN=__PUT_GITHUB_TOKEN_HERE__

# --- Trending seed ---
# Default: https://github.com/trending
SEED_TRENDING_URL=https://github.com/trending

# Cache TTL for trending seed (format TBD by implementation).
# Examples (choose one approach later): "00:10:00" (TimeSpan), "600" (seconds), "10m"
SEED_CACHE_TTL=10m

# --- GitHub GraphQL behavior ---
# Max concurrent GitHub requests (keep conservative; tune later).
GITHUB_MAX_CONCURRENCY=4

# Page size for GraphQL connections. Must be within 1..100.
GITHUB_PAGE_SIZE=50

# --- Sync scheduling ---
# Hangfire recurring schedule (format TBD by implementation).
# Common choices:
# - Cron (e.g., "*/30 * * * *" = every 30 minutes)
# - Duration string (e.g., "30m")
SYNC_INTERVAL=*/30 * * * *

# --- Database ---
# PostgreSQL connection string (example uses local docker-compose defaults).
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=github_trending;Username=postgres;Password=postgres

# --- Retry / backoff (names are suggestions; keep stable once implemented) ---
# If you later prefer different names, update docs/requirements.md and this template together.
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=200
RETRY_MAX_DELAY_MS=5000
